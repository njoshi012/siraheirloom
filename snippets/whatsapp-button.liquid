{%- comment -%}
  WhatsApp buttons. Usage:
    {% render 'whatsapp-button', style: 'order' %}     wide "Customization & Order" button (product page)
    {% render 'whatsapp-button', style: 'floating' %}  floating round icon (site-wide)
{%- endcomment -%}
{%- liquid
  assign wa_number = '918949629758'
  assign wa_text = 'Hello, I would like to enquire about customization & order.'
  if style == 'order' and product != blank
    assign wa_text = 'Hello, I would like to customize and order: ' | append: product.title | append: ' ' | append: shop.url | append: product.url
  endif
  assign wa_text_encoded = wa_text | url_encode
  assign wa_link = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_text_encoded
-%}
{%- capture wa_icon -%}
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false" width="26" height="26"><path fill="currentColor" d="M16.003 3C8.83 3 3 8.83 3 16c0 2.29.6 4.53 1.74 6.5L3 29l6.66-1.7A12.95 12.95 0 0 0 16 29c7.17 0 13-5.83 13-13S23.17 3 16.003 3zm0 23.7c-2.02 0-4-.55-5.72-1.58l-.41-.24-3.95 1.01 1.05-3.84-.27-.4A10.64 10.64 0 0 1 5.3 16c0-5.9 4.8-10.7 10.7-10.7S26.7 10.1 26.7 16s-4.8 10.7-10.7 10.7zm5.87-8c-.32-.16-1.9-.94-2.2-1.05-.3-.11-.51-.16-.73.16-.21.32-.83 1.05-1.02 1.26-.19.21-.37.24-.7.08-.32-.16-1.36-.5-2.59-1.6-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.5.14-.66.14-.14.32-.37.48-.56.16-.19.21-.32.32-.54.11-.21.05-.4-.03-.56-.08-.16-.73-1.76-1-2.4-.26-.63-.53-.54-.73-.55h-.62c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.15 3.09 1.31 3.3c.16.21 2.26 3.45 5.47 4.84.76.33 1.36.53 1.82.68.77.24 1.46.21 2.01.13.61-.09 1.9-.78 2.16-1.53.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37z"/></svg>
{%- endcapture -%}

{%- if style == 'floating' -%}
  <a
    class="wa-float"
    href="{{ wa_link }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat on WhatsApp"
  >{{ wa_icon }}</a>
  <style>
    .wa-float {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 50;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: #25d366;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
      transition: transform 0.2s ease;
    }
    .wa-float:hover { transform: scale(1.08); }
    .wa-float svg { width: 28px; height: 28px; }
  </style>
{%- else -%}
  <a
    class="wa-order"
    href="{{ wa_link }}"
    target="_blank"
    rel="noopener noreferrer"
  >
    <span class="wa-order__icon">{{ wa_icon }}</span>
    <span class="wa-order__text">Customization &amp; Order</span>
  </a>
  <style>
    .wa-order {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      position: relative;
      z-index: 1;
      clear: both;
      margin-top: 40px;
      padding: 14px 20px;
      background: #1a1a1a;
      color: #fff;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 700;
      font-size: 12px;
      line-height: 1;
      transition: background 0.2s ease;
    }
    .wa-order:hover { background: #000; color: #fff; }
    .wa-order__icon { display: inline-flex; color: #25d366; }
  </style>
{%- endif -%}
