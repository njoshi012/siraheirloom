<style>
  #ShoppableLook-{{ section.id }} {
    --sl-pad-top: {{ section.settings.padding_top }}px;
    --sl-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sl-max: {{ section.settings.max_width }}px;
  }

  .sl {
    padding-block: var(--sl-pad-top) var(--sl-pad-bottom);
    background: {{ section.settings.background_color }};
    color: var(--color-foreground, #292421);
  }

  .sl__frame {
    position: relative;
    max-width: var(--sl-max);
    margin-inline: auto;
    padding-inline: 16px;
    box-sizing: border-box;
  }

  .sl__stage {
    position: relative;
    border-radius: 6px;
  }

  .sl__image,
  .sl__stage svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .sl__spot {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    width: 0;
    height: 0;
  }

  .sl__dot {
    position: absolute;
    left: -14px;
    top: -14px;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.45);
    cursor: pointer;
    display: grid;
    place-items: center;
    animation: sl-pulse 2.4s ease-out infinite;
  }

  .sl__dot::after {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fff;
  }

  @keyframes sl-pulse {
    0% { box-shadow: 0 0 0 0 rgb(255 255 255 / 0.55); }
    70%, 100% { box-shadow: 0 0 0 12px rgb(255 255 255 / 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sl__dot {
      animation: none;
    }
  }

  .sl__card {
    position: absolute;
    top: 22px;
    left: 0;
    z-index: 3;
    width: 230px;
    transform: translateX(-50%);
    display: none;
    gap: 12px;
    align-items: center;
    padding: 10px;
    border-radius: 10px;
    background: #fff;
    color: #1a1a1a;
    text-decoration: none;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.2);
    font-size: 0.85rem;
  }

  .sl__spot[data-open] {
    z-index: 4;
  }

  .sl__spot[data-open] .sl__card {
    display: flex;
  }

  .sl__spot[data-align='left'] .sl__card {
    transform: none;
    left: -14px;
  }

  .sl__spot[data-align='right'] .sl__card {
    transform: none;
    left: auto;
    right: -14px;
  }

  .sl__spot[data-up] .sl__card {
    top: auto;
    bottom: 22px;
  }

  .sl__card img {
    width: 56px;
    height: 72px;
    object-fit: cover;
    border-radius: 4px;
    flex: none;
  }

  .sl__card-info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sl__card-title {
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sl__card-price s {
    opacity: 0.55;
    margin-inline-start: 4px;
  }
</style>

<section id="ShoppableLook-{{ section.id }}" class="sl">
  {% render 'ornament-heading', heading: section.settings.heading, ornament: section.settings.ornament %}

  <div class="sl__frame">
    <shoppable-look class="sl__stage">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            class: 'sl__image sl__image--desktop',
            widths: '750, 1100, 1500, 2000',
            sizes: '(min-width: 750px) 1200px, 100vw',
            loading: 'lazy',
            alt: section.settings.heading
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}

      {% for block in section.blocks %}
        {%- liquid
          assign product = block.settings.product
          assign align = 'center'
          if block.settings.x < 28
            assign align = 'left'
          elsif block.settings.x > 72
            assign align = 'right'
          endif
        -%}
        <div
          class="sl__spot"
          style="--x: {{ block.settings.x }}; --y: {{ block.settings.y }};"
          data-align="{{ align }}"
          {% if block.settings.y > 60 %}data-up{% endif %}
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="sl__dot"
            aria-expanded="false"
            aria-label="{{ product.title | default: 'Product' | escape }}"
          ></button>
          {% if product != blank %}
            <a class="sl__card" href="{{ product.url }}">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 200
                  | image_tag: width: 56, height: 72, loading: 'lazy', alt: ''
                }}
              {% endif %}
              <span class="sl__card-info">
                <span class="sl__card-title">{{ product.title | escape }}</span>
                <span class="sl__card-price">
                  {{ product.price | money }}
                  {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
                </span>
              </span>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </shoppable-look>
  </div>
</section>

<script>
  if (!customElements.get('shoppable-look')) {
    class ShoppableLook extends HTMLElement {
      connectedCallback() {
        this.spots = Array.from(this.querySelectorAll('.sl__spot'));
        this.onClick = (event) => {
          const spot = event.target.closest('.sl__spot');
          const dot = event.target.closest('.sl__dot');
          this.spots.forEach((s) => {
            if (s !== spot || !dot) {
              s.removeAttribute('data-open');
              s.querySelector('.sl__dot')?.setAttribute('aria-expanded', 'false');
            }
          });
          if (spot && dot) {
            const open = !spot.hasAttribute('data-open');
            spot.toggleAttribute('data-open', open);
            dot.setAttribute('aria-expanded', String(open));
          }
        };
        document.addEventListener('click', this.onClick);
      }

      disconnectedCallback() {
        document.removeEventListener('click', this.onClick);
      }
    }

    customElements.define('shoppable-look', ShoppableLook);
  }
</script>

{% schema %}
{
  "name": "Shop the look (image)",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop The Look" },
    {
      "type": "select",
      "id": "ornament",
      "label": "Heading ornament",
      "options": [
        { "value": "leaf", "label": "Leaf" },
        { "value": "diamond", "label": "Diamond" },
        { "value": "none", "label": "None" }
      ],
      "default": "leaf"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "max_width", "min": 500, "max": 1600, "step": 50, "unit": "px", "label": "Maximum width", "default": 1200 },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#00000000" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal position", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical position", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look (image)",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 25, "y": 60 } },
        { "type": "hotspot", "settings": { "x": 50, "y": 50 } },
        { "type": "hotspot", "settings": { "x": 75, "y": 55 } }
      ]
    }
  ]
}
{% endschema %}
