<style>
  #IG-{{ section.id }} {
    --ig-pad-top: {{ section.settings.padding_top }}px;
    --ig-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ig-per-view: 2;
    --ig-gap: 12px;
  }

  @media (min-width: 750px) {
    #IG-{{ section.id }} { --ig-per-view: {{ section.settings.per_view_desktop }}; --ig-gap: 16px; }
  }

  .ig {
    padding-block: var(--ig-pad-top) var(--ig-pad-bottom);
    background: {{ section.settings.background_color }};
    color: var(--color-foreground, #292421);
  }

  .ig__sub {
    text-align: center;
    margin: 8px 16px 24px;
    font-size: 0.95rem;
  }

  .ig__sub a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }

  .ig__wrap {
    display: block;
    position: relative;
    max-width: 1300px;
    margin-inline: auto;
  }

  .ig__track {
    display: flex;
    gap: var(--ig-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-inline: 16px;
    scroll-padding-inline: 16px;
  }

  .ig__track::-webkit-scrollbar { display: none; }

  .ig__item {
    position: relative;
    flex: 0 0 calc((100% - 32px - var(--ig-gap) * (var(--ig-per-view) - 1)) / var(--ig-per-view));
    aspect-ratio: 9 / 16;
    scroll-snap-align: start;
    overflow: hidden;
    background: #e9e2d8;
    display: block;
  }

  .ig__item video,
  .ig__item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ig__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 26px;
    height: 26px;
    color: #fff;
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.5));
    pointer-events: none;
  }

  .ig__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: #292421;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.2);
    cursor: pointer;
    display: none;
    place-items: center;
  }

  .ig__arrow--prev { left: 8px; }
  .ig__arrow--next { right: 8px; }

  @media (min-width: 750px) {
    .ig__arrow { display: grid; }
  }

  .ig__arrow[disabled] { opacity: 0.35; cursor: default; }

  .ig__cta { text-align: center; margin-top: 24px; }

  .ig__button {
    display: inline-block;
    padding: 12px 28px;
    background: #1a1a1a;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .ig__empty { text-align: center; padding: 24px 16px; opacity: 0.6; }
</style>

<section id="IG-{{ section.id }}" class="ig">
  {% render 'ornament-heading', heading: section.settings.heading, ornament: section.settings.ornament %}

  {%- if section.settings.handle != blank -%}
    <p class="ig__sub">
      <a href="{{ section.settings.profile_url }}" target="_blank" rel="noopener noreferrer">@{{ section.settings.handle }}</a>
    </p>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ig-carousel class="ig__wrap">
      <button type="button" class="ig__arrow ig__arrow--prev" aria-label="Previous" data-prev>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"/></svg>
      </button>
      <div class="ig__track" data-track>
        {%- for block in section.blocks -%}
          {%- assign link = block.settings.link | default: section.settings.profile_url -%}
          <a
            class="ig__item"
            href="{{ link }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Watch on Instagram"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, image_size: '540x960', preload: 'metadata'
              }}
            {%- elsif block.settings.poster != blank -%}
              {{ block.settings.poster | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {%- endif -%}
            <svg class="ig__badge" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          </a>
        {%- endfor -%}
      </div>
      <button type="button" class="ig__arrow ig__arrow--next" aria-label="Next" data-next>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>
      </button>
    </ig-carousel>
  {%- else -%}
    <p class="ig__empty">Add video blocks to show your Instagram reels.</p>
  {%- endif -%}

  {%- if section.settings.button_label != blank and section.settings.profile_url != blank -%}
    <div class="ig__cta">
      <a class="ig__button" href="{{ section.settings.profile_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.button_label }}</a>
    </div>
  {%- endif -%}
</section>

<script>
  if (!customElements.get('ig-carousel')) {
    customElements.define(
      'ig-carousel',
      class extends HTMLElement {
        connectedCallback() {
          const track = this.querySelector('[data-track]');
          const prev = this.querySelector('[data-prev]');
          const next = this.querySelector('[data-next]');
          if (!track || !prev || !next) return;
          const step = () => {
            const item = track.querySelector('.ig__item');
            return item ? item.getBoundingClientRect().width + 16 : 300;
          };
          const update = () => {
            prev.disabled = track.scrollLeft <= 2;
            next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
          };
          prev.addEventListener('click', () => track.scrollBy({ left: -step() * 2, behavior: 'smooth' }));
          next.addEventListener('click', () => track.scrollBy({ left: step() * 2, behavior: 'smooth' }));
          track.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', update);
          update();
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "Instagram videos",
  "tag": "section",
  "class": "section-instagram-videos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow Us on Instagram" },
    {
      "type": "select",
      "id": "ornament",
      "label": "Heading ornament",
      "options": [
        { "value": "leaf", "label": "Leaf" },
        { "value": "diamond", "label": "Diamond" },
        { "value": "none", "label": "None" }
      ],
      "default": "diamond"
    },
    { "type": "text", "id": "handle", "label": "Instagram handle", "default": "siraheirloom" },
    { "type": "url", "id": "profile_url", "label": "Instagram profile link", "default": "https://www.instagram.com/siraheirloom" },
    { "type": "text", "id": "button_label", "label": "Button text", "info": "Leave empty to hide the button.", "default": "Follow on Instagram" },
    { "type": "range", "id": "per_view_desktop", "min": 3, "max": 6, "step": 1, "label": "Videos per view (desktop)", "default": 4 },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Upload the reel's video file (MP4)." },
        { "type": "image_picker", "id": "poster", "label": "Image (used if no video)" },
        { "type": "url", "id": "link", "label": "Reel link", "info": "Opens this Instagram reel on click. Defaults to your profile." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Instagram videos",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
