{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.product_count
-%}

<style>
  #ProductCarousel-{{ section.id }} {
    --pc-rows: {{ section.settings.rows_mobile }};
    --pc-cols-mobile: {{ section.settings.columns_mobile }};
    --pc-cols-desktop: {{ section.settings.columns_desktop }};
    --pc-pad-top: {{ section.settings.padding_top }}px;
    --pc-pad-bottom: {{ section.settings.padding_bottom }}px;
  }

  .pc {
    padding-block: var(--pc-pad-top) var(--pc-pad-bottom);
    background: {{ section.settings.background_color }};
    color: var(--color-foreground, #292421);
  }

  .pc__track {
    --pc-gap: 14px;
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(var(--pc-rows), auto);
    grid-auto-columns: calc((100% - 20px - var(--pc-gap) * (var(--pc-cols-mobile) - 1)) / (var(--pc-cols-mobile) + 0.15));
    gap: 22px var(--pc-gap);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding-inline: 20px;
    scroll-padding-inline: 20px;
  }

  .pc__track::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 750px) {
    .pc__track {
      --pc-gap: 20px;
      --pc-rows: 1;
      grid-auto-columns: calc((100% - 80px - var(--pc-gap) * (var(--pc-cols-desktop) - 1)) / var(--pc-cols-desktop));
      padding-inline: 40px;
      scroll-padding-inline: 40px;
    }
  }

  .pc__card {
    scroll-snap-align: start;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.85rem;
  }

  .pc__card a {
    color: inherit;
    text-decoration: none;
  }

  .pc__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 6px;
    background: rgb(0 0 0 / 0.05);
  }

  .pc__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.4s ease, transform 0.5s ease;
  }

  .pc__media img + img {
    opacity: 0;
  }

  @media (hover: hover) {
    .pc__card:hover .pc__media img + img {
      opacity: 1;
    }

    .pc__card:hover .pc__media img:first-child:not(:only-child) {
      opacity: 0;
    }

    .pc__card:hover .pc__media img:only-child {
      transform: scale(1.04);
    }
  }

  .pc__badge {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-start: 8px;
    z-index: 1;
    padding: 2px 7px;
    border-radius: 3px;
    background: var(--pc-badge-bg, #9c7d66);
    color: #fff;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pc__badge--sold-out {
    --pc-badge-bg: #5a5a5a;
  }

  .pc__rating {
    min-height: 1.1em;
    line-height: 1;
  }

  .pc__title {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .pc__prices {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    font-weight: 600;
  }

  .pc__prices s {
    font-weight: 400;
    opacity: 0.55;
  }

  .pc__save {
    color: #2e7d32;
    font-size: 0.78rem;
  }

  .pc__empty {
    padding: 40px 20px;
    text-align: center;
    opacity: 0.7;
  }

  .pc__footer {
    margin-top: 28px;
    text-align: center;
  }

  .pc__button {
    display: inline-block;
    padding: 12px 28px;
    border: 1px solid currentColor;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }
</style>

<section id="ProductCarousel-{{ section.id }}" class="pc">
  {% render 'ornament-heading', heading: section.settings.heading, ornament: section.settings.ornament %}

  {% if collection != blank and collection.products.size > 0 %}
    <div class="pc__track">
      {% for product in collection.products limit: limit %}
        {%- liquid
          assign second_image = product.images[1]
          assign on_sale = false
          if product.compare_at_price > product.price
            assign on_sale = true
            assign saved = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
          endif
        -%}
        <div class="pc__card">
          <a class="pc__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {%- if product.available == false -%}
              <span class="pc__badge pc__badge--sold-out">{{ section.settings.sold_out_label }}</span>
            {%- elsif section.settings.badge_label != blank -%}
              <span class="pc__badge">{{ section.settings.badge_label | escape }}</span>
            {%- endif -%}
            {%- if product.featured_image -%}
              {{
                product.featured_image
                | image_url: width: 800
                | image_tag: widths: '300, 450, 600, 800', sizes: '(min-width: 750px) 25vw, 45vw', loading: 'lazy', alt: product.featured_image.alt
              }}
            {%- endif -%}
            {%- if second_image -%}
              {{
                second_image
                | image_url: width: 800
                | image_tag: widths: '300, 450, 600, 800', sizes: '(min-width: 750px) 25vw, 45vw', loading: 'lazy', alt: ''
              }}
            {%- endif -%}
          </a>
          <a class="pc__title" href="{{ product.url }}">{{ product.title | escape }}</a>
          {%- if section.settings.show_rating -%}
            <div class="jdgm-widget jdgm-preview-badge pc__rating" data-id="{{ product.id }}"></div>
          {%- endif -%}
          <div class="pc__prices">
            <span>{{ product.price | money_with_currency }}</span>
            {% if on_sale %}<s>{{ product.compare_at_price | money_with_currency }}</s>{% endif %}
          </div>
          {% if on_sale and section.settings.show_save %}
            <span class="pc__save">{{ section.settings.save_label | escape }} {{ saved }}%</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_label != blank %}
      <div class="pc__footer">
        <a class="pc__button" href="{{ collection.url }}">{{ section.settings.button_label | escape }}</a>
      </div>
    {% endif %}
  {% else %}
    <p class="pc__empty">Choose a collection with products for this section.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured products slider",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    {
      "type": "select",
      "id": "ornament",
      "label": "Heading ornament",
      "options": [
        { "value": "leaf", "label": "Leaf" },
        { "value": "diamond", "label": "Diamond" },
        { "value": "none", "label": "None" }
      ],
      "default": "diamond"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_count", "min": 2, "max": 24, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "text", "id": "button_label", "label": "\"View all\" button text", "info": "Leave empty to hide the button.", "default": "View all" },
    { "type": "header", "content": "Product cards" },
    { "type": "text", "id": "badge_label", "label": "Badge text", "info": "Shown on every product. Leave empty for none.", "default": "New" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out badge text", "default": "Sold out" },
    { "type": "checkbox", "id": "show_save", "label": "Show \"Save %\" on discounted products", "default": true },
    { "type": "text", "id": "save_label", "label": "\"Save\" text", "default": "Save" },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Judge.me star rating",
      "info": "Needs the Judge.me app installed with its app embed turned on (Theme editor > App embeds).",
      "default": true
    },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns on mobile", "default": 2 },
    { "type": "range", "id": "rows_mobile", "min": 1, "max": 2, "step": 1, "label": "Rows on mobile", "default": 2 },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 6, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#00000000" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "presets": [
    { "name": "Featured products slider" }
  ]
}
{% endschema %}
