<style>
  #WhyShop-{{ section.id }} {
    --ws-pad-top: {{ section.settings.padding_top }}px;
    --ws-pad-bottom: {{ section.settings.padding_bottom }}px;
  }

  .ws {
    padding-block: var(--ws-pad-top) var(--ws-pad-bottom);
    background: {{ section.settings.background_color }};
    color: var(--color-foreground, #292421);
  }

  .ws__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  @media (min-width: 750px) {
    .ws__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ws__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 28px 12px;
    text-align: center;
    font-size: 0.82rem;
    box-shadow: inset -1px 0 0 rgb(0 0 0 / 0.07), inset 0 -1px 0 rgb(0 0 0 / 0.07);
  }

  .ws__item:nth-child(2n) {
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.07);
  }

  @media (min-width: 750px) {
    .ws__item:nth-child(2n) {
      box-shadow: inset -1px 0 0 rgb(0 0 0 / 0.07);
    }

    .ws__item {
      box-shadow: inset -1px 0 0 rgb(0 0 0 / 0.07);
    }

    .ws__item:last-child {
      box-shadow: none;
    }
  }

  .ws__item:last-child,
  .ws__item:nth-last-child(2):nth-child(odd) {
    box-shadow: none;
  }

  .ws__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    color: #9c7d66;
  }

  .ws__icon svg,
  .ws__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>

<section id="WhyShop-{{ section.id }}" class="ws">
  {% render 'ornament-heading', heading: section.settings.heading, ornament: section.settings.ornament %}

  <div class="ws__grid">
    {% for block in section.blocks %}
      <div class="ws__item" {{ block.shopify_attributes }}>
        <span class="ws__icon" aria-hidden="true">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 160 | image_tag: width: 56, height: 56, loading: 'lazy', alt: '' }}
          {%- else -%}
            <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" focusable="false">
              {%- case block.settings.icon -%}
                {%- when 'shipping' -%}
                  <path d="M6 18h30v26H6z"/><path d="M36 26h12l8 9v9H36z"/><circle cx="17" cy="47" r="4"/><circle cx="46" cy="47" r="4"/>
                {%- when 'payment' -%}
                  <rect x="6" y="14" width="40" height="28" rx="3"/><path d="M6 24h40"/><path d="M46 36c0 8 6 12 8 13 2-1 8-5 8-13v-6l-8-3-8 3z"/>
                {%- when 'return' -%}
                  <path d="M52 32a20 20 0 1 1-6-14"/><path d="M48 8v10H38"/><path d="M28 24h8l-6 16"/>
                {%- when 'quality' -%}
                  <circle cx="32" cy="32" r="22"/><circle cx="32" cy="32" r="16"/><path d="M24 32l6 6 10-12"/>
                {%- else -%}
                  <path d="M12 32l14 14L52 18"/>
              {%- endcase -%}
            </svg>
          {%- endif -%}
        </span>
        <span>{{ block.settings.text | escape }}</span>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Why shop with us",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Shop With Us ?" },
    {
      "type": "select",
      "id": "ornament",
      "label": "Heading ornament",
      "options": [
        { "value": "leaf", "label": "Leaf" },
        { "value": "diamond", "label": "Diamond" },
        { "value": "none", "label": "None" }
      ],
      "default": "diamond"
    },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#00000000" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Delivery truck" },
            { "value": "payment", "label": "Secure payment" },
            { "value": "return", "label": "Returns" },
            { "value": "quality", "label": "Quality badge" },
            { "value": "check", "label": "Tick" }
          ],
          "default": "shipping"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon", "info": "Optional. Replaces the icon above." },
        { "type": "text", "id": "text", "label": "Text", "default": "Free Shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why shop with us",
      "blocks": [
        { "type": "feature", "settings": { "icon": "shipping", "text": "Free Shipping" } },
        { "type": "feature", "settings": { "icon": "payment", "text": "Secure Payment" } },
        { "type": "feature", "settings": { "icon": "return", "text": "7 days return" } },
        { "type": "feature", "settings": { "icon": "quality", "text": "Quality Guaranteed" } }
      ]
    }
  ]
}
{% endschema %}
